{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supabase/supabase-js": "^2.112.2",
    "expo": "~57.0.11",
    "expo-dev-client": "~57.0.10",
    "expo-font": "^57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "^57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eas-cli": "^21.7.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "react-test-renderer": "^19.2.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:rls": "jest --config jest.rls.config.js",
    "typecheck": "tsc --noEmit",
    "bootstrap": "npm ci && npm run env:pull",
    "env:pull": "eas env:pull --environment development",
    "build:dev": "eas build --profile development --platform ios",
    "build:sim": "eas build --profile preview --platform ios",
    "build:list": "eas build:list --platform ios --limit 5"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "private": true
}
