# Copy to `.env` and fill in from the Supabase dashboard: Settings -> API.
#
# Both values are safe in a client binary and ship inside the app bundle — the
# publishable key identifies an anonymous client of this project, it does not
# grant access. Row-level security is the access layer (ADR-0010).
#
# `.env` is gitignored anyway: the moment a secret key exists, the pathway for
# it has to already be safe.
#
# NEVER put the `service_role` / secret key (`sb_secret_...`) here. It bypasses
# RLS entirely and would make every policy in the schema decorative.
#
# `EXPO_PUBLIC_`-prefixed variables are inlined into the bundle at build time,
# which is what makes them readable from app code.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Labelled `anon` / `public` in the classic dashboard, or `Publishable key`
# (`sb_publishable_...`) in the current one. Same key, renamed.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
