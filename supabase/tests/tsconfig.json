{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": ["jest", "node"],
    "typeRoots": ["../../app/node_modules/@types"],
    // Dependencies live in `app/node_modules`; this suite sits outside `app/`,
    // so resolution has to be pointed at them explicitly.
    "baseUrl": "../../app/node_modules",
    "paths": {
      "*": ["*"]
    }
  },
  "include": ["./**/*.ts"]
}
